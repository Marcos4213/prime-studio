{
  "name": "prime-central",
  "version": "0.1.0",
  "private": true,
  "description": "Central do Cliente da Prime Studio — app + API em Cloudflare Workers (MVP Fases 0-2).",
  "type": "module",
  "scripts": {
    "predev": "node features/load.js --write src/feature-menu.json",
    "dev": "wrangler dev",
    "test": "node --test features/load.test.js src/lib/copy-method.test.js src/lib/ai.test.js",
    "db:create": "wrangler d1 create prime-central",
    "db:migrate:local": "wrangler d1 migrations apply prime-central --local",
    "db:migrate:remote": "wrangler d1 migrations apply prime-central --remote",
    "types": "wrangler types",
    "deploy": "echo 'Deploy só com o OK do Marcos. Rode wrangler deploy manualmente.' && exit 1"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
